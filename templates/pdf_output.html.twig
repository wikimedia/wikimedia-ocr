{% extends 'base.html.twig' %}

{% block body %}
    <form method="get" action="{{ path('pdf') }}">
        <fieldset>
            <legend>PDF OCR - {{ msg('form-heading') }}</legend>
            <div class="form-group">
                <label for="image">PDF URL</label>
                <input name="image" id="image" class="form-control" type="url" value="{{ image }}"
                       required placeholder="https://upload.wikimedia.org/wikipedia/commons/.../file.pdf" />
                <p class="help-block">
                    Enter a Wikimedia Commons PDF URL. Allowed hosts: {{ image_hosts }}
                </p>
            </div>

            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="start_page">Start Page</label>
                        <input name="start_page" id="start_page" class="form-control" type="number" min="1"
                               value="{{ app.request.get('start_page') ?: 1 }}" placeholder="1" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="end_page">End Page</label>
                        <input name="end_page" id="end_page" class="form-control" type="number" min="1"
                               value="{{ app.request.get('end_page') ?: 20 }}" placeholder="20" />
                    </div>
                </div>
                <div class="col-md-6">
                    <p class="help-block" style="margin-top: 25px;">
                        Maximum 20 pages per request. For larger PDFs, process in batches.
                    </p>
                </div>
            </div>

            <div class="form-group">
                <label>{{ msg('engine') }}</label>
                <div class="radio">
                    <label>
                        <input type="radio" name="engine" value="google" {% if engine == 'google' %}checked{% endif %} />
                        {{ msg('engine-name-google') }}
                    </label>
                </div>
                <div class="radio">
                    <label>
                        <input type="radio" name="engine" value="tesseract" {% if engine == 'tesseract' %}checked{% endif %} />
                        {{ msg('engine-name-tesseract') }}
                    </label>
                </div>
                <div class="radio">
                    <label>
                        <input type="radio" name="engine" value="transkribus" {% if engine == 'transkribus' %}checked{% endif %} />
                        {{ msg('engine-name-transkribus') }}
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label for="lang">{{ msg('language-code') }}</label>
                <select id="lang" class="form-control" name="langs[]" multiple
                        data-placeholder="{{ msg('langs-placeholder') }}">
                    {% for lang_code,lang_name in available_langs %}
                        <option value="{{ lang_code }}" {% if lang_code in langs %}selected{% endif %}>
                            {{- lang_code }} &ndash; {{ lang_name -}}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </fieldset>

        {% include '_tesseract_options.html.twig' with {engine: engine} %}

        <div class="form-group submit-btn">
            <input type="submit" value="Process PDF" class="submit-full btn btn-info" />
        </div>

        <div class="loader hidden">
            <p>
                <span class="glyphicon glyphicon-refresh" aria-hidden="true"></span>
                {{ msg('loading-message') }}
            </p>
        </div>

        {% if pdf_result is defined and pdf_result is not null %}
            <div class="ocr-output">
                <hr/>

                {# Summary section #}
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title">PDF Processing Summary</h3>
                    </div>
                    <div class="panel-body">
                        <p><strong>Total Pages:</strong> {{ pdf_result.totalPages }}</p>
                        <p><strong>OCR'd Pages (Text &amp; Image+Text):</strong>
                            {% if pdf_result.ocrPages|length > 0 %}
                                {{ pdf_result.ocrPages|join(', ') }}
                            {% else %}
                                None
                            {% endif %}
                        </p>
                        <p><strong>Skipped Pages (Image only):</strong>
                            {% if pdf_result.skippedPages|length > 0 %}
                                {{ pdf_result.skippedPages|join(', ') }}
                            {% else %}
                                None
                            {% endif %}
                        </p>
                    </div>
                </div>

                {# Page classification details #}
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title">Page Classifications</h3>
                    </div>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Page</th>
                                <th>Type</th>
                                <th>OCR'd</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for classification in pdf_result.classifications %}
                                <tr class="{% if classification.type == 'Image' %}warning{% elseif classification.type == 'Image+Text' %}info{% else %}success{% endif %}">
                                    <td>{{ classification.pageNumber }}</td>
                                    <td>
                                        {% if classification.type == 'Text' %}
                                            <span class="label label-success">Text</span>
                                        {% elseif classification.type == 'Image+Text' %}
                                            <span class="label label-info">Image+Text</span>
                                        {% else %}
                                            <span class="label label-warning">Image</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if classification.hasText %}
                                            Yes
                                        {% else %}
                                            Skipped
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {# Per-page text output #}
                {% for page_num, page_text in pdf_result.pageTexts %}
                    {% if page_text|trim is not empty %}
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <h3 class="panel-title">
                                    Page {{ page_num }}
                                    {% set page_classification = pdf_result.classifications[page_num] is defined ? pdf_result.classifications[page_num] : null %}
                                    {% if page_classification %}
                                        <span class="label label-{% if page_classification.type == 'Text' %}success{% else %}info{% endif %}">
                                            {{ page_classification.type }}
                                        </span>
                                    {% endif %}
                                </h3>
                            </div>
                            <div class="panel-body">
                                <textarea class="form-control" rows="{{ page_text|split('\n')|length + 2 }}" readonly>{{ page_text }}</textarea>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}

                {# Full combined text #}
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h3 class="panel-title">
                            Full Extracted Text
                            <button class="btn btn-sm btn-default pull-right copy-button"
                                    data-copied-text="{{ msg('copied-to-clipboard') }}"
                                    style="margin-top: -5px;">
                                {{ msg('copy-to-clipboard') }}
                            </button>
                        </h3>
                    </div>
                    <div class="panel-body">
                        <textarea class="form-control" rows="{{ text|split('\n')|length + 2 }}" id="text">{{ text }}</textarea>
                    </div>
                </div>
            </div>
        {% endif %}
    </form>

{% endblock %}
